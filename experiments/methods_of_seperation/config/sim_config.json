{
  "experiment_version": "1.0.0",

  "default_sampling_interval": 1.0,
  "default_total_time": 60,
  "noise_sigma": 0.02,

  "default_input_ranges": {
    "particle_size": [1, 1000],
    "solubility": [0, 100],
    "density_difference": [0, 5000],
    "impurity_percentage": [0, 100],
    "solvent_volume": [0, 1000],
    "evaporation_temperature": [20, 120]
  },

  "constants": {
    "gravity": 9.81,

    "filtration_efficiency": {
      "cloth": 0.6,
      "filter_paper": 0.85,
      "sieve": 0.7
    },

    "magnetic_separation_efficiency": {
      "magnetic": 0.9,
      "non_magnetic": 0.0
    },

    "evaporation_rate_factor": 0.05,

    "sedimentation_rate_factor": 0.03,

    "manual_efficiency_levels": {
      "low": 0.6,
      "medium": 0.8,
      "high": 0.95
    }
  },

  "visual": {
    "max_particles": 300,
    "particle_size_scale": 1.5,
    "separation_progress_steps": 50,
    "highlight_active_method": true
  }
}
